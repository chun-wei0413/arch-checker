<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="SSD-AddFavorite" id="ssd_add_favorite">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SSD - Add Favorite (Happy Path)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="user_actor" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="135" y="70" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="system_box" value=":System" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=4;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="user_lifeline" style="endArrow=none;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="160" as="sourcePoint" />
            <mxPoint x="155" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="system_lifeline" style="endArrow=none;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="125" as="sourcePoint" />
            <mxPoint x="600" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="1: searchBusLine(busLineName)" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="210" as="sourcePoint" />
            <mxPoint x="600" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r1" value="busLine : BusLine (with stops &amp; buses)" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="280" as="sourcePoint" />
            <mxPoint x="155" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: addToFavorite(stopIdx, groupName)" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="380" as="sourcePoint" />
            <mxPoint x="600" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r2" value="successMessage" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="450" as="sourcePoint" />
            <mxPoint x="155" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="desc_title" value="說明 (Description)" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="780" height="24" as="geometry" />
        </mxCell>
        <mxCell id="desc_body" value="本圖呈現「常用站牌 (Add Favorite)」use case happy path 跨越系統邊界的兩個 system events：&#10;&#10;1.  &lt;b&gt;searchBusLine(busLineName)&lt;/b&gt;&#10;     使用者輸入欲查詢的公車路線。系統回傳 BusLine (含該路線的方向、站牌列表與即時班車狀態)。&#10;&#10;2.  &lt;b&gt;addToFavorite(stopIdx, groupName)&lt;/b&gt;&#10;     使用者在 UI 上選定要收藏的站牌、輸入新群組名稱並按下確認後，把站牌索引與群組名稱&#10;     一次傳給系統。系統建立新的 FavoriteGroup、把 (busLine, stop) 包裝為 Favorite 加入&#10;     該群組，最後回傳 successMessage。&#10;&#10;&lt;b&gt;備註：&lt;/b&gt;&#10;  •  滑動列表、點選 stop、按下「加到常用站牌」彈出群組輸入框、輸入名稱…&#10;     這些都屬於 UI 操作，未跨越系統邊界 → 不列為 system event。&#10;     真正的系統行為只有「使用者按下確認、把資料一次送到系統」這一刻。&#10;  •  若使用者選擇既有群組而非新建，仍以同一個 addToFavorite(stopIdx, groupName)&#10;     處理 - 系統依 groupName 判斷新建或加入既有群組。" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="780" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
