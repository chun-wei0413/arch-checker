<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="SSD-PlanRoute" id="ssd_plan_route">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SSD - Plan Route (Happy Path)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="540" height="32" as="geometry" />
        </mxCell>
        <mxCell id="user_actor" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="135" y="70" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="system_box" value=":System" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=4;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="user_lifeline" style="endArrow=none;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="160" as="sourcePoint" />
            <mxPoint x="155" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="system_lifeline" style="endArrow=none;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="125" as="sourcePoint" />
            <mxPoint x="600" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg1" value="1: searchRoutes(start, end, time, preference)" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="210" as="sourcePoint" />
            <mxPoint x="600" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ret1" value="routeOptions : List&amp;lt;TravelPlan&amp;gt;" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="280" as="sourcePoint" />
            <mxPoint x="155" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="2: selectRoute(routeIdx)" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="380" as="sourcePoint" />
            <mxPoint x="600" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ret2" value="routeDetail : TravelPlan" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="450" as="sourcePoint" />
            <mxPoint x="155" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="desc_title" value="說明 (Description)" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="780" height="24" as="geometry" />
        </mxCell>
        <mxCell id="desc_body" value="本圖呈現「路線規劃 (Plan Route)」use case happy path 中跨越系統邊界的兩個 system events：&#10;&#10;1.  &lt;b&gt;searchRoutes(start, end, time, preference)&lt;/b&gt;&#10;     使用者輸入起點 / 終點與時間 / 偏好後執行搜尋。系統回傳可行的路線方案清單 routeOptions&#10;     (每個方案包含預估總時間、票價與轉乘次數)。&#10;&#10;2.  &lt;b&gt;selectRoute(routeIdx)&lt;/b&gt;&#10;     使用者從清單中挑選一條方案。系統展開並回傳該方案的完整關卡資訊 routeDetail&#10;     (含步行段、上下車站牌與搭乘段)。&#10;&#10;頁面導覽 (enterPlanRoutePage)、輸入欄位填寫與預設值顯示屬 UI 層互動，未跨越系統邊界，&#10;故本 SSD 省略，僅保留兩個真正觸發系統行為的 system events。" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="780" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
