        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-532" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" value="routeOptions : List&amp;lt;TravelPlan&amp;gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2729.5" y="3020" as="sourcePoint" />
            <mxPoint x="2544.5" y="3020" as="targetPoint" />
