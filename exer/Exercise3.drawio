        <mxCell id="yacA3FKVwqHyYD2nbtZP-576" edge="1" parent="1" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=12;" value="3.1: getStops()">
          <mxGeometry relative="1" as="geometry">
