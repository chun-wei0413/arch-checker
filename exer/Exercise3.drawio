          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-577" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" value="stops : List&amp;lt;Stop&amp;gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2590" y="1382" as="sourcePoint" />
            <mxPoint x="1945" y="1382" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-578" edge="1" parent="1" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=12;" value="3.2: getBuses()">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1945" y="1432" as="sourcePoint" />
            <mxPoint x="2590" y="1432" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-579" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" value="buses : List&amp;lt;Bus&amp;gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2590" y="1482" as="sourcePoint" />
            <mxPoint x="1945" y="1482" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-580" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" value="busLine : BusLine&#xa;(with directions, stops and live bus locations)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1945" y="1582" as="sourcePoint" />
            <mxPoint x="1760" y="1582" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-581" parent="1" style="text;html=1;align=left;fontSize=14;fontStyle=1;" value="說明 (Description)" vertex="1">
          <mxGeometry height="24" width="1080" x="1710" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-582" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=10;" value="FavoriteController 接到 system event &lt;b&gt;searchBusLine(busLineName)&lt;/b&gt; 後的執行流程：&#xa;&#xa;1.  Controller 把查詢委派給 BusTable.findByName(busLineName)，取得對應的 bl : BusLine (Information Expert - BusTable 擁有所有 BusLine)。&#xa;     Controller 把 bl 暫存為 currentBusLine 以供下一個 system event (addToFavorite) 使用。&#xa;2.  Controller 對 bl 呼叫 getDirections()，取得方向 (去程 / 回程) 清單 directions : List&amp;lt;BusLineDirection&amp;gt;&#xa;     (Information Expert - BusLine 擁有自己的 directions)。&#xa;3.  loop：對每個 BusLineDirection 呼叫 getStops() 取得 stops : List&amp;lt;Stop&amp;gt;、&#xa;     以及 getBuses() 取得 buses : List&amp;lt;Bus&amp;gt; (即時班車位置)&#xa;     (Information Expert - BusLineDirection 擁有自己的 stops 與 buses)。&#xa;4.  Controller 把組合好的 busLine : BusLine (含方向、站牌與即時班車狀態) 回傳給 UI 呈現詳細列表。&#xa;&#xa;&lt;b&gt;GRASP 對照：&lt;/b&gt;&#xa;  •  Controller         → FavoriteController 接收 searchBusLine 的 system event&#xa;  •  Information Expert → BusTable / BusLine / BusLineDirection 各自負責自己擁有的資料&#xa;  •  Low Coupling       → Controller 透過介面層層詢問，不直接走訪內部結構" vertex="1">
          <mxGeometry height="350" width="1080" x="1710" y="1770" as="geometry" />
        </mxCell>
