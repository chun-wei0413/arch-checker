        <mxCell id="yacA3FKVwqHyYD2nbtZP-555" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" value="routeDetail">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4155" y="2950" as="sourcePoint" />
            <mxPoint x="3970" y="2950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-556" parent="1" style="text;html=1;align=left;fontSize=14;fontStyle=1;" value="說明 (Description)" vertex="1">
          <mxGeometry height="24" width="1080" x="3930" y="3100" as="geometry" />
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-557" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=10;" value="PlanRouteController 接到 system event &lt;b&gt;selectRoute(routeIdx)&lt;/b&gt; 後的執行流程：&#xa;&#xa;1.  Controller 呼叫 TravelPlans.getTravelPlan(routeIdx) 取出使用者所選的 TravelPlan (Information Expert，TravelPlans 擁有方案清單)。&#xa;2.  Controller 呼叫 tp.getRoutes() 取得該方案的所有 Route 物件 (Information Expert，TravelPlan 擁有自己的 routes)。&#xa;3.  loop：對每條 Route 呼叫 getStepInfo()。透過 &lt;b&gt;Polymorphism&lt;/b&gt;，WalkRoute 與 BusRoute 各自決定如何描述自己 - &#xa;     步行段顯示起終座標；搭乘段顯示上下車站牌、票價與該段公車路線。Controller 不需要 if/switch 判斷型別。&#xa;4.  Controller 把所有 stepInfo 組合成 routeDetail 回傳給 UI 展開顯示。&#xa;&#xa;&lt;b&gt;GRASP 對照：&lt;/b&gt;&#xa;  •  Controller         → PlanRouteController 接收 selectRoute system event&#xa;  •  Information Expert → TravelPlans (方案清單擁有者) / TravelPlan (擁有 routes)&#xa;  •  Polymorphism       → Route.getStepInfo() 抽象方法，由 WalkRoute / BusRoute 多型實作&#xa;  •  Low Coupling       → 加入新的 Route 子類別 (例如 BikeRoute) 時，本 SD 與 Controller 邏輯均不需修改" vertex="1">
          <mxGeometry height="290" width="1080" x="3930" y="3130" as="geometry" />
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-558" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="SD - searchBusLine(busLineName)" vertex="1">
