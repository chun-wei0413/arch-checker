        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-640" edge="1" parent="1" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" value="1: searchRoutes(start, end, time, preference)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="946.0023529411766" y="2800.004705882353" as="sourcePoint" />
            <mxPoint x="1391.0023529411765" y="2800.004705882353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-641" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" value="routeOptions : List&amp;lt;TravelPlan&amp;gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1391.0023529411765" y="2870.004705882353" as="sourcePoint" />
            <mxPoint x="946.0023529411766" y="2870.004705882353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-642" edge="1" parent="1" style="endArrow=block;html=1;verticalAlign=bottom;align=center;fontSize=13;" value="2: selectRoute(routeIdx)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="946.0023529411766" y="2970.004705882353" as="sourcePoint" />
            <mxPoint x="1391.0023529411765" y="2970.004705882353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-643" edge="1" parent="1" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=13;" value="routeDetail : TravelPlan">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1391.0023529411765" y="3040.004705882353" as="sourcePoint" />
            <mxPoint x="946.0023529411766" y="3040.004705882353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-644" parent="1" style="text;html=1;align=left;fontSize=14;fontStyle=1;" value="說明 (Description)" vertex="1">
          <mxGeometry height="24" width="780" x="851.0023529411766" y="3240.004705882353" as="geometry" />
        </mxCell>
        <mxCell id="yacA3FKVwqHyYD2nbtZP-645" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=10;" value="本圖呈現「路線規劃 (Plan Route)」use case happy path 中跨越系統邊界的兩個 system events：&#xa;&#xa;1.  &lt;b&gt;searchRoutes(start, end, time, preference)&lt;/b&gt;&#xa;     使用者輸入起點 / 終點與時間 / 偏好後執行搜尋。系統回傳可行的路線方案清單 routeOptions&#xa;     (每個方案包含預估總時間、票價與轉乘次數)。&#xa;&#xa;2.  &lt;b&gt;selectRoute(routeIdx)&lt;/b&gt;&#xa;     使用者從清單中挑選一條方案。系統展開並回傳該方案的完整關卡資訊 routeDetail&#xa;     (含步行段、上下車站牌與搭乘段)。&#xa;&#xa;頁面導覽 (enterPlanRoutePage)、輸入欄位填寫與預設值顯示屬 UI 層互動，未跨越系統邊界，&#xa;故本 SSD 省略，僅保留兩個真正觸發系統行為的 system events。" vertex="1">
