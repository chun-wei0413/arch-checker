        <mxCell id="r3" value="routeOptions : List&amp;lt;TravelPlan&amp;gt;" style="endArrow=open;endFill=0;endSize=10;html=1;dashed=1;verticalAlign=bottom;align=center;fontSize=12;" edge="1" parent="1">
