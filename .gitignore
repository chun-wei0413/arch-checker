# IDE - IntelliJ IDEA
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# MS Office lock files (auto-created while a doc is open in Word/PowerPoint)
~$*.docx
~$*.pptx
~$*.xlsx

# Maven build output (will be added when src/ exists)
target/

# Java
*.class
*.jar

# Logs
*.log

# Python cache (used by .claude skill scripts)
__pycache__/
*.pyc

# Midterm slide QA renders (intermediate)
hw/Midterm/slides_jpg/

# Demo runtime artifacts — generated by 'suppress' / '--json' commands
demo/.arch-checker-suppress.yaml
demo/sample-project-report.json

# docx skill working directory — re-create with scripts/office/unpack.py
hw/**/unpacked/
