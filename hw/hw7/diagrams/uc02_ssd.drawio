    <!-- Return: validationResult -->
    <mxCell id="e2_ret" value="Profile 'name' is valid. Loaded N rule(s):&#xa;  - R-NAME-01 (NamingRule)  - R-DEP-01 (DependencyRule) ..." style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;" edge="1" parent="1">
