    <!-- Note box -->
    <mxCell id="note" value="Both events are triggered via CLI subcommands:&#xa;  arch-checker profile init &lt;outputPath&gt;&#xa;  arch-checker profile validate &lt;yamlPath&gt;" style="text;html=1;align=left;fontSize=10;strokeColor=#d6b656;fillColor=#fffacd;rounded=1;" vertex="1" parent="1">
