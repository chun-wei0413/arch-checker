    <!-- System boundary box -->
    <mxCell id="sys_box" value="arch-checker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="480" y="60" width="200" height="40" as="geometry" />
    </mxCell>
    <mxCell id="sys_line" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="580" y="100" as="sourcePoint" />
        <mxPoint x="580" y="560" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ===== System Event 1: initProfile ===== -->
    <!-- Separator label -->
    <mxCell id="sep1" value="«system event 1»" style="text;html=1;align=left;fontStyle=2;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="145" width="200" height="20" as="geometry" />
    </mxCell>

    <!-- initProfile(outputPath) call -->
    <mxCell id="e1_call" value="initProfile(outputPath)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;fontSize=11;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="105" y="175" as="sourcePoint" />
        <mxPoint x="580" y="175" as="targetPoint" />
        <mxPoint x="0" y="-12" as="offset" />
      </mxGeometry>
    </mxCell>

    <!-- Activation box on system -->
    <mxCell id="act1" value="" style="fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="575" y="175" width="10" height="50" as="geometry" />
    </mxCell>

    <!-- Return: profileTemplateWritten(path) -->
    <mxCell id="e1_ret" value="Profile template written to: outputPath" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="575" y="225" as="sourcePoint" />
        <mxPoint x="105" y="225" as="targetPoint" />
        <mxPoint x="0" y="-12" as="offset" />
      </mxGeometry>
    </mxCell>

    <!-- Gap label: Developer edits YAML -->
    <mxCell id="gap1" value="Developer edits the generated YAML template" style="text;html=1;align=center;fontStyle=2;fontSize=10;strokeColor=#999999;fillColor=#f0f0f0;" vertex="1" parent="1">
      <mxGeometry x="130" y="245" width="330" height="25" as="geometry" />
    </mxCell>

    <!-- ===== System Event 2: validateProfile ===== -->
    <mxCell id="sep2" value="«system event 2»" style="text;html=1;align=left;fontStyle=2;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="285" width="200" height="20" as="geometry" />
    </mxCell>

    <!-- validateProfile(yamlPath) call -->
    <mxCell id="e2_call" value="validateProfile(yamlPath)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;fontSize=11;" edge="1" parent="1">
