    </mxCell>
    <mxCell id="e2_err" value="Validation failed: &lt;error message&gt;  (exit code 2)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
